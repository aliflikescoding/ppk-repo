generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @db.Uuid
  email        String        @unique @db.VarChar(50)
  user_name    String        @unique @db.VarChar(50)
  // Stores a bcrypt hash, never the plaintext password.
  password     String        @db.VarChar(60)
  // Allowed values: 'user', 'admin', 'employee'. Default: 'user'.
  role         String        @default("user") @db.VarChar(8)
  reports      Report[]
  reservations Reservation[]

  @@map("users")
}

model Facility {
  id           Int              @id @default(autoincrement())
  capacity     Int
  name         String           @db.VarChar(50)
  // New facilities are inactive by default.
  is_active    Boolean          @default(false)
  type_id      Int
  location_id  Int
  type         FacilityType     @relation(fields: [type_id], references: [id])
  location     FacilityLocation @relation(fields: [location_id], references: [id])
  images       FacilityImage[]
  reports      Report[]
  reservations Reservation[]

  @@map("facilities")
}

model FacilityType {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(50)
  facilities Facility[]

  @@map("facility_types")
}

model FacilityLocation {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(50)
  facilities Facility[]

  @@map("facility_locations")
}

model FacilityImage {
  id          Int      @id @default(autoincrement())
  facility_id Int
  image_url   String   @db.VarChar(500)
  facility    Facility @relation(fields: [facility_id], references: [id])

  @@map("facility_images")
}

model Report {
  id           Int            @id @default(autoincrement())
  user_id      String         @db.Uuid
  facility_id  Int
  category_id  Int            @unique
  // Allowed values: 'new', 'processed', 'done', 'rejected'. Default: 'new'.
  status       String         @default("new") @db.VarChar(9)
  description  String         @db.VarChar(500)
  photo_report String
  reaseon      String?        @db.VarChar(500)
  user         User           @relation(fields: [user_id], references: [id])
  facility     Facility       @relation(fields: [facility_id], references: [id])
  category     ReportCategory @relation(fields: [category_id], references: [id])

  @@map("reports")
}

model ReportCategory {
  id     Int     @id @default(autoincrement())
  name   String  @db.VarChar(50)
  report Report?

  @@map("report_categories")
}

model Reservation {
  id          Int       @id @default(autoincrement())
  user_id     String    @db.Uuid
  facility_id Int
  // Start time must be between 07:00 and 20:00; enforce in application validation or SQL constraints.
  start_time  DateTime  @db.Timestamp(6)
  // End time must be between 07:00 and 20:00; enforce in application validation or SQL constraints.
  end_time    DateTime  @db.Timestamp(6)
  // New reservations are not accepted by default.
  isAccepted  Boolean   @default(false)
  // Defaults to the current timestamp when omitted.
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  user        User      @relation(fields: [user_id], references: [id])
  facility    Facility  @relation(fields: [facility_id], references: [id])

  @@map("reservations")
}
