# Server port (defaults to 5000).
PORT=5000

# PostgreSQL connection used by Prisma.
# Replace the username, password, host, port, and database with your own values.
# URL-encode special characters in the username and password.
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/ppk?schema=public"

# Required for login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=""

# Credentials used by npm run script:generateAdmin.
ADMIN_EMAIL="admin@example.com"
ADMIN_USER_NAME="admin"
ADMIN_PASSWORD=""

# Optional password for the two sample users and two employees.
# Defaults to Password123 when omitted.
SEED_PASSWORD="Password123"
